# ---- คัดลอกเป็น .env แล้วเติมค่า (ห้าม commit ไฟล์ .env) ----
# cp .env.example .env && chmod 600 .env

# ผู้ให้บริการ AI: gemini (ฟรี) | groq (ฟรี) | openrouter (เสียเงิน)
AGENT_PROVIDER=gemini

# คีย์ของ Gemini ฟรี — ขอที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ทางเลือก: Groq ฟรี — ขอที่ https://console.groq.com/keys
GROQ_API_KEY=

# ทางเลือก: OpenRouter — ขอที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- ปรับแต่ง (ไม่ใส่ก็ได้) ----
# AGENT_MODEL=gemini-2.5-flash
# ANDROID_DEVICE=
# AGENT_MAX_STEPS=25
# AGENT_STEP_PAUSE=1.5
# AGENT_IMAGE_WIDTH=720
# ระดับการถามยืนยัน: risky (ค่าเริ่มต้น) | all | none
AGENT_CONFIRM_MODE=risky

# ---- Telegram (ไม่บังคับ แต่แนะนำ: ใช้กดอนุมัติจากมือถือ) ----
# สร้างบอทกับ @BotFather แล้วเอา token มาใส่
TELEGRAM_BOT_TOKEN=
# chat id ของคุณ (ส่งข้อความหาบอท แล้วเปิด .../getUpdates ดู id)
TELEGRAM_CHAT_ID=
